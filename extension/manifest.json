{
  "manifest_version": 3,
  "name": "Omarchy Web Theme",
  "version": "1.1.1",
  "description": "Theme browser pages with your live Omarchy palette.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Omarchy Web Theme",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "theme-utils.js",
        "page-theme.js"
      ],
      "css": [
        "page-theme.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-api.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://wallpapers.hel1.your-objectstorage.com/*"
  ]
}
